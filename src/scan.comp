// Exclusive prefix sum of a chunk's per-ray crossing counts (src/trace.comp
// pass 0 or 2) on the device, in three dispatches of this one shader (`step`
// in the push constants), so the offsets pass 1 writes at and src/compact.comp
// reads never visit the host:
//   step 0, one group per block of 1024 counts: the block's sum into `blocks`
//   step 1, one group: `blocks` scanned in place (exclusive), the chunk's total
//           of crossings written after the last block
//   step 2, one group per block: each count's offset, the block's offset plus
//           the exclusive prefix within the block
// Integer adds in a fixed order: the same offsets on every device. Vulkan 1.0:
// shared memory and barriers only, no subgroup operations, no atomics.
// Compiled by `uv run scripts generate` into src/trace_spirv.hpp
#version 450

layout(local_size_x = 256) in;
#define GROUP 256u
#define PER_LANE 4u
#define BLOCK (GROUP * PER_LANE)

layout(set = 0, binding = 0, std430) readonly buffer CountBuffer { uint counts[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OffsetBuffer { uint offsets[]; };
layout(set = 0, binding = 2, std430) buffer BlockBuffer { uint blocks[]; };
layout(push_constant) uniform Constants {
    uint count;        // rays in the chunk
    uint step;         // 0, 1 or 2 as above
    uint block_count;  // ceil(count / 1024)
};

shared uint partial[GROUP];

// the inclusive prefix of `value` across the group (Hillis-Steele); partial[GROUP - 1] is the total after
uint scan_group(uint lane, uint value) {
    partial[lane] = value;
    barrier();
    for (uint offset = 1u; offset < GROUP; offset <<= 1u) {
        const uint below = lane >= offset ? partial[lane - offset] : 0u;
        barrier();
        partial[lane] += below;
        barrier();
    }
    return partial[lane];
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint block = gl_WorkGroupID.x;
    if (step == 1u) {
        uint carry = 0u;
        for (uint base = 0u; base < block_count; base += GROUP) {
            const uint i = base + lane;
            const uint value = i < block_count ? blocks[i] : 0u;
            const uint inclusive = scan_group(lane, value);
            if (i < block_count) {
                blocks[i] = carry + inclusive - value;
            }
            carry += partial[GROUP - 1u];
            barrier();  // every lane has read the total before the next round overwrites it
        }
        if (lane == 0u) {
            blocks[block_count] = carry;
        }
        return;
    }
    // steps 0 and 2: this lane's four consecutive counts of the block
    uint value[PER_LANE];
    uint sum = 0u;
    for (uint k = 0u; k < PER_LANE; k++) {
        const uint i = block * BLOCK + lane * PER_LANE + k;
        value[k] = i < count ? counts[i] : 0u;
        sum += value[k];
    }
    const uint inclusive = scan_group(lane, sum);
    if (step == 0u) {
        if (lane == GROUP - 1u) {
            blocks[block] = inclusive;
        }
        return;
    }
    uint exclusive = blocks[block] + inclusive - sum;
    for (uint k = 0u; k < PER_LANE; k++) {
        const uint i = block * BLOCK + lane * PER_LANE + k;
        if (i < count) {
            offsets[i] = exclusive;
        }
        exclusive += value[k];
    }
}
