# The checkers that run src/parallel.hpp's promises, on top of the dev image:
# GenMC (https://github.com/MPI-SWS/genmc), which runs the header itself in
# every execution the C++ memory model allows (`uv run scripts genmc`,
# check/verify/genmc), and TLC (https://github.com/tlaplus/tlaplus), which checks the
# protocol's model in every interleaving (`uv run scripts model`, check/verify/tla).
# Its own image, so only those stages pay for LLVM's development files and a
# JRE. Each is pinned: GenMC by commit, built against the dev image's own LLVM
# (19); TLC by its jar's sha256; the packages by the Debian snapshot the dev
# image records, so moving the base moves these with it
FROM trimkit-dev

USER root
RUN apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        cmake g++ llvm-19-dev libedit-dev libffi-dev zlib1g-dev libzstd-dev libxml2-dev \
        openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# GenMC v0.20.0, the newest release when this was written (2026-10-31)
ARG GENMC_COMMIT=fab5bba7d9efaf76990227c2f59d62c11c7ea2a3
RUN git clone --quiet https://github.com/MPI-SWS/genmc /tmp/genmc \
    && git -C /tmp/genmc checkout --quiet "$GENMC_COMMIT" \
    && test "$(git -C /tmp/genmc rev-parse HEAD)" = "$GENMC_COMMIT" \
    && cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/genmc \
        -DLLVM_DIR=/usr/lib/llvm-19/lib/cmake/llvm -B /tmp/genmc/build -S /tmp/genmc \
    && cmake --build /tmp/genmc/build -j"$(nproc)" \
    && cmake --install /tmp/genmc/build \
    && rm -rf /tmp/genmc

# TLC v1.7.4, the newest release that isn't a pre-release (2024-08-05)
ARG TLA_TOOLS=https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
ARG TLA_TOOLS_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
RUN curl -fsSL -o /opt/tla2tools.jar "$TLA_TOOLS" \
    && echo "$TLA_TOOLS_SHA256  /opt/tla2tools.jar" | sha256sum -c -

WORKDIR /src
