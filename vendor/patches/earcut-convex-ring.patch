+// check whether every vertex of a ring is strictly convex (trimkit: earcut.js PR #212)
+template <typename N>
+bool Earcut<N>::isConvex(Node* start) {
+    Node* p = start;
+    do {
+        if (area(p->prev, p, p->next) >= 0) return false;
+        p = p->next;
+    } while (p != start);
+    return true;
