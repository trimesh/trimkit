+    direction[Eigen::Index((axis + 2) % 3)] =
+        Scalar(2 * (cell % side) + 1) / Scalar(side) - 1;
+    Vec3s support;
+    coal::details::getShapeSupport<false, IndexType>(
+        this, direction, support, support_hint, support_data);
